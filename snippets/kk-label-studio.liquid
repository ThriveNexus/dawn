{%- comment -%}
  KOSMETIKAL — Editorul de etichete (markup). Randat din blocul Custom Liquid
  „butoane” al paginii de produs, cu dimensiunile etichetei ca parametri:
  {% render 'kk-label-studio', kk_lw: ..., kk_lh: ..., kk_lback: ..., kk_lcenter: ...,
     kk_bleed: ..., kk_pack: ..., kk_legal: ..., kk_vol: ... %}
  Logica e în assets/kk-label-studio.js; textele vin din locales/*.json (kk.studio*).
{%- endcomment -%}
{%- assign m = product.metafields.custom -%}

  {{ 'kk-label-studio.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'kk-label-studio.js' | asset_url }}" defer></script>

  <div class="kk-studio" data-kk-studio hidden
       data-kk-fabric="{{ 'kk-fabric.min.js' | asset_url }}"
       data-kk-libs='{"opentype":"{{ 'kk-lib-opentype.js' | asset_url }}","jspdf":"{{ 'kk-lib-jspdf.js' | asset_url }}","svg2pdf":"{{ 'kk-lib-svg2pdf.js' | asset_url }}","jszip":"{{ 'kk-lib-jszip.js' | asset_url }}","three":"{{ 'kk-lib-three.js' | asset_url }}","orbit":"{{ 'kk-lib-orbit.js' | asset_url }}","roomenv":"{{ 'kk-lib-roomenv.js' | asset_url }}"}'
       {%- comment -%}
         Copiile .txt, nu .ttf: CDN-ul Shopify convertește orice asset .ttf în
         WOFF2 la servire, iar opentype.js (conturarea la export) nu citește
         WOFF2. Extensia .txt lasă octeții neatinși. Fișierele .ttf rămân
         pentru @font-face — acolo WOFF2 e chiar mai bun, fiind mai mic.
       {%- endcomment -%}
       data-kk-fonts='{"Montserrat":"{{ 'kk-fontdata-montserrat.txt' | asset_url }}","Inter":"{{ 'kk-fontdata-inter.txt' | asset_url }}","Source Sans 3":"{{ 'kk-fontdata-sourcesans.txt' | asset_url }}","Bodoni Moda":"{{ 'kk-fontdata-bodonimoda.txt' | asset_url }}","Archivo Narrow":"{{ 'kk-fontdata-archivonarrow.txt' | asset_url }}","Arimo":"{{ 'kk-fontdata-arimo.txt' | asset_url }}"}'
       data-kk-fontlic="{{ 'kk-fonts-LICENSES.txt' | asset_url }}"
       data-kk-pack="{{ kk_pack }}"
       data-kk-photodef="{{ 'kk-photo-tube-neutral.jpg' | asset_url }}"
       data-kk-phototube="{{ 'kk-photo-tube-2.jpg' | asset_url }}"
       data-kk-photobottle="{{ 'kk-photo-bottle.jpg' | asset_url }}"
       data-kk-photojar="{{ 'kk-photo-jar-2.jpg' | asset_url }}"
       data-kk-photodropper="{{ 'kk-photo-dropper.jpg' | asset_url }}"
       {%- if product.featured_image %} data-kk-photo="{{ product.featured_image | image_url: width: 1600 }}"{% endif -%}
       {%- if m.mockup.value != blank %} data-kk-mockup="{{ m.mockup.value | escape }}"{% endif -%}
       data-kk-lw="{{ kk_lw }}"
       data-kk-lh="{{ kk_lh }}"
       data-kk-back="{{ kk_lback }}"
       data-kk-center="{{ kk_lcenter }}"
       data-kk-bleed="{{ kk_bleed }}"
       data-kk-legal="{{ kk_legal | strip | escape }}"
       data-kk-name="{{ product.title | escape }}">

    {%- comment -%}
      Textele editorului (kk-label-studio.js e un asset, fără Liquid): vin de aici,
      din dicționarul temei; fără ele JS-ul cade pe engleza din cod.
    {%- endcomment -%}
    <script type="application/json" data-kk-i18n>
      {
        "not_loaded": {{ 'kk.studio_js.not_loaded_html' | t | json }},
        "seam": {{ 'kk.studio_js.seam_html' | t | json }},
        "back_locked": {{ 'kk.studio_js.back_locked_html' | t | json }},
        "legal_readable": {{ 'kk.studio_js.legal_readable_html' | t | json }},
        "low_contrast": {{ 'kk.studio_js.low_contrast_html' | t | json }},
        "dpi_warn": {{ 'kk.studio_js.dpi_warn_html' | t: dpi: '__dpi__' | json }},
        "layer_legal": {{ 'kk.studio_js.layer_legal_html' | t | json }},
        "layer_image": {{ 'kk.studio_js.layer_image_html' | t | json }},
        "layer_text": {{ 'kk.studio_js.layer_text_html' | t | json }},
        "layer_circle": {{ 'kk.studio_js.layer_circle_html' | t | json }},
        "layer_triangle": {{ 'kk.studio_js.layer_triangle_html' | t | json }},
        "layer_rect": {{ 'kk.studio_js.layer_rect_html' | t | json }},
        "show_hide": {{ 'kk.studio_js.show_hide_html' | t | json }},
        "required_by_law": {{ 'kk.studio_js.required_by_law_html' | t | json }},
        "move_up": {{ 'kk.studio_js.move_up_html' | t | json }},
        "move_down": {{ 'kk.studio_js.move_down_html' | t | json }},
        "delete": {{ 'kk.studio_js.delete_html' | t | json }},
        "your_brand": {{ 'kk.fields.your_brand_html' | t | json }},
        "img_too_big": {{ 'kk.studio_js.img_too_big_html' | t | json }},
        "preparing": {{ 'kk.studio_js.preparing_html' | t | json }},
        "pack_attached": {{ 'kk.studio_js.pack_attached_html' | t: w: '__w__', h: '__h__' | json }},
        "svg_attached": {{ 'kk.studio_js.svg_attached_html' | t: w: '__w__', h: '__h__' | json }},
        "attach_failed": {{ 'kk.studio_js.attach_failed_html' | t | json }},
        "preview3d_failed": {{ 'kk.studio_js.preview3d_failed_html' | t | json }},
        "photo_failed": {{ 'kk.studio_js.photo_failed_html' | t | json }},
        "close_confirm": {{ 'kk.studio_js.close_confirm_html' | t | json }},
        "copied": {{ 'kk.studio_js.copied_html' | t | json }},
        "mockup_attached": {{ 'kk.studio_js.mockup_attached_html' | t | json }},
        "mockup_failed": {{ 'kk.studio_js.mockup_failed_html' | t | json }}
      }
    </script>

    <div class="kk-studio-bar">
      <h2 class="kk-studio-title">{{ 'kk.studio.title' | t }}</h2>
      <span class="kk-studio-dims">{{ kk_lw }} &times; {{ kk_lh }} mm</span>
      <label class="kk-guides-toggle">
        <input type="checkbox" checked data-kk-guides-toggle>
        <span>{{ 'kk.studio.guides' | t }}</span>
      </label>

      <span class="kk-zoom">
        <button type="button" class="kk-zoom-btn" data-kk-zoom="-" aria-label="{{ 'kk.studio.zoom_out' | t }}">&minus;</button>
        <span class="kk-zoom-val" data-kk-zoom-val>100%</span>
        <button type="button" class="kk-zoom-btn" data-kk-zoom="+" aria-label="{{ 'kk.studio.zoom_in' | t }}">+</button>
        <button type="button" class="kk-zoom-btn kk-zoom-fit" data-kk-zoom="fit">{{ 'kk.studio.fit' | t }}</button>
      </span>

      <button type="button" class="kk-btn kk-btn--bar" data-kk-mock-open hidden>{{ 'kk.studio.preview_mockup' | t }}</button>
      <button type="button" class="kk-btn kk-btn--bar" data-kk-studio-download>{{ 'kk.studio.download' | t }}</button>
      <button type="button" class="kk-btn kk-btn--bar kk-btn--solid" data-kk-studio-done>{{ 'kk.studio.use_design' | t }}</button>
      <button type="button" class="kk-studio-x" data-kk-studio-close aria-label="{{ 'kk.studio.close' | t }}">&times;</button>
    </div>

    <div class="kk-studio-main">
      <div class="kk-studio-stage">
        <div class="kk-studio-frame">
          <canvas data-kk-canvas></canvas>
          <div class="kk-studio-guides" data-kk-guides></div>
        </div>
      </div>

      <aside class="kk-studio-side">
        {%- comment -%}
          Valorile reale ale produsului, ca butoane de inserare. Clientul nu-și
          bate capul să transcrie INCI-ul sau volumul — dă click și apare corect.
          Se trimit ca JSON ca să nu hardcodăm lista în JS: ce nu e completat
          pe produs nu apare deloc.
        {%- endcomment -%}
        <script type="application/json" data-kk-fields>
          {
            {{ 'kk.fields.brand_html' | t | json }}: {{ 'kk.fields.your_brand_html' | t | json }},
            {{ 'kk.fields.title_html' | t | json }}: {{ product.title | json }}
            {%- if kk_vol != blank -%}, {{ 'kk.fields.volume_html' | t | json }}: {{ kk_vol | json }}{%- endif -%}
            {%- if m.inci.value != blank -%}, {{ 'kk.fields.inci_html' | t | json }}: {{ m.inci.value | json }}{%- endif -%}
            {%- if m.active_ingredients.value != blank -%}, {{ 'kk.fields.key_ingredients_html' | t | json }}: {{ m.active_ingredients.value | join: ', ' | json }}{%- endif -%}
            {%- if m.claims.value != blank -%}, {{ 'kk.fields.claims_html' | t | json }}: {{ m.claims.value | join: ' · ' | json }}{%- endif -%}
            {%- if m.recommended_for.value != blank -%}, {{ 'kk.fields.skin_type_html' | t | json }}: {{ m.recommended_for.value | join: ', ' | json }}{%- endif -%}
            {%- if m.skin_concerns.value != blank -%}, {{ 'kk.fields.concerns_html' | t | json }}: {{ m.skin_concerns.value | join: ', ' | json }}{%- endif -%}
            {%- if m.how_to_use.value != blank -%}, {{ 'kk.fields.how_to_use_html' | t | json }}: {{ m.how_to_use.value | json }}{%- endif -%}
          }
        </script>

        <div class="kk-tool">
          <span class="kk-tool-lab">{{ 'kk.studio.product_info' | t }}</span>
          <div class="kk-chips" data-kk-fieldlist></div>
          <p class="kk-tool-hint">
            {{ 'kk.studio.product_info_hint' | t }}
          </p>
        </div>

        <div class="kk-tool">
          <span class="kk-tool-lab">{{ 'kk.studio.shapes' | t }}</span>
          <div class="kk-shapes">
            <button type="button" class="kk-shape" data-kk-shape="rect" aria-label="{{ 'kk.studio.square' | t }}"></button>
            <button type="button" class="kk-shape kk-shape--circle" data-kk-shape="circle" aria-label="{{ 'kk.studio.circle' | t }}"></button>
            <button type="button" class="kk-shape kk-shape--tri" data-kk-shape="triangle" aria-label="{{ 'kk.studio.triangle' | t }}"></button>
            <button type="button" class="kk-shape kk-shape--line" data-kk-shape="line" aria-label="{{ 'kk.studio.line' | t }}"></button>
          </div>
        </div>

        <div class="kk-tool">
          <span class="kk-tool-lab">{{ 'kk.studio.label_bg' | t }}</span>
          <div class="kk-swatches">
            <button type="button" class="kk-swatch" data-kk-swatch="#ffffff" style="background:#ffffff" aria-label="{{ 'kk.studio.white' | t }}"></button>
            <button type="button" class="kk-swatch" data-kk-swatch="#f4f1ea" style="background:#f4f1ea" aria-label="{{ 'kk.studio.cream' | t }}"></button>
            <button type="button" class="kk-swatch" data-kk-swatch="#e8e2d5" style="background:#e8e2d5" aria-label="{{ 'kk.studio.sand' | t }}"></button>
            <button type="button" class="kk-swatch" data-kk-swatch="#c8d5c4" style="background:#c8d5c4" aria-label="{{ 'kk.studio.sage' | t }}"></button>
            <button type="button" class="kk-swatch" data-kk-swatch="#1d1d1b" style="background:#1d1d1b" aria-label="{{ 'kk.studio.black' | t }}"></button>
          </div>
          <div class="kk-field">
            <span>{{ 'kk.studio.custom' | t }}</span>
            <input type="color" value="#ffffff" data-kk-bg aria-label="{{ 'kk.studio.bg_aria' | t }}">
          </div>
        </div>

        <div class="kk-tool">
          <span class="kk-tool-lab">{{ 'kk.studio.legal_panel' | t }}</span>
          <div class="kk-field">
            <span>{{ 'kk.studio.panel' | t }}</span>
            <input type="color" value="#ffffff" data-kk-legal-bg aria-label="{{ 'kk.studio.legal_bg_aria' | t }}">
          </div>
          <div class="kk-field">
            <span>{{ 'kk.studio.text' | t }}</span>
            <input type="color" value="#111111" data-kk-legal-fg aria-label="{{ 'kk.studio.legal_fg_aria' | t }}">
          </div>
          <label class="kk-tool-hint kk-legal-nopanel">
            <input type="checkbox" data-kk-legal-panel>
            {{ 'kk.studio.white_panel' | t }}
          </label>
          <p class="kk-tool-hint kk-tool-warn" data-kk-legal-warn hidden>
            {{ 'kk.studio.low_contrast' | t }}
          </p>
          <p class="kk-tool-hint kk-tool-warn" data-kk-legal-size hidden>
            {{ 'kk.studio.back_small' | t }}
          </p>
        </div>

        <div class="kk-tool">
          <span class="kk-tool-lab">{{ 'kk.studio.add' | t }}</span>
          <label class="kk-tool-btn" for="kk-studio-img">
            {{ 'kk.studio.add_image' | t }}
            <input class="kk-tool-file" type="file" id="kk-studio-img"
                   accept="image/png,image/jpeg,image/svg+xml" data-kk-add-image>
          </label>
          <button type="button" class="kk-tool-btn" data-kk-add-text>{{ 'kk.studio.add_text' | t }}</button>
          <p class="kk-tool-hint">
            {{ 'kk.studio.add_hint' | t }}
          </p>
          <p class="kk-tool-hint kk-tool-warn" data-kk-lowres hidden></p>
        </div>

        <div class="kk-tool" data-kk-selected hidden>
          <span class="kk-tool-lab">{{ 'kk.studio.selected' | t }}</span>
          <div class="kk-field" data-kk-text-only hidden>
            <span>{{ 'kk.studio.font' | t }}</span>
            {%- comment -%}
              Doar fonturi găzduite în temă (OFL) — fără fonturi de sistem.
              Motivul: la export textul se conturează din exact fișierul care
              l-a randat; un font de sistem diferă de la o mașină la alta
              (Helvetica nici nu există pe Windows).
            {%- endcomment -%}
            <select data-kk-font aria-label="{{ 'kk.studio.font' | t }}">
              <option value="Montserrat">Montserrat</option>
              <option value="Inter">Inter</option>
              <option value="Source Sans 3">Source Sans</option>
              <option value="Bodoni Moda">Bodoni</option>
              <option value="Archivo Narrow">Archivo Narrow</option>
              <option value="Arimo">Arimo</option>
            </select>
          </div>
          <div class="kk-field" data-kk-text-only hidden>
            <span>{{ 'kk.studio.size' | t }}</span>
            <input type="range" min="8" max="140" data-kk-size aria-label="{{ 'kk.studio.text_size_aria' | t }}">
          </div>
          <div class="kk-field" data-kk-text-only hidden>
            <span>{{ 'kk.studio.colour' | t }}</span>
            <input type="color" data-kk-color aria-label="{{ 'kk.studio.text_colour_aria' | t }}">
          </div>
          <button type="button" class="kk-tool-btn kk-tool-btn--danger" data-kk-del>{{ 'kk.studio.remove_selected' | t }}</button>
        </div>

        <div class="kk-tool">
          <span class="kk-tool-lab">{{ 'kk.studio.layers' | t }}</span>
          <ul class="kk-layers" data-kk-layers></ul>
        </div>

        <div class="kk-tool">
          <button type="button" class="kk-tool-btn" data-kk-reset>{{ 'kk.studio.start_over' | t }}</button>
        </div>
      </aside>
    </div>

    {%- comment -%}
      Previzualizarea 3D: flaconul construit din geometrie după dimensiunile în
      milimetri ale etichetei (lățimea = circumferința), cu eticheta desenată ca
      textură pe el. Se rotește liber — se văd și fața, și panoul legal din spate.
      Flaconul e reprezentativ, nu ambalajul exact al furnizorului; eticheta e exactă.
      Totul în browser, fără servicii externe.
    {%- endcomment -%}
    <div class="kk-mock" data-kk-mock hidden>
      <div class="kk-mock-stage">
        <div class="kk-mock-wrap" data-kk-mock-wrap>
          <canvas data-kk-mock-canvas></canvas>
          {%- comment -%}
            Vederea foto are canvas separat: cel de sus e WebGL, iar un canvas
            nu poate avea și context 3D, și context 2D.
          {%- endcomment -%}
          <canvas data-kk-mock-photo hidden></canvas>
          <button type="button" class="kk-mock-h" data-kk-mock-h="0" hidden aria-label="{{ 'kk.studio.corner' | t: n: 1 }}"></button>
          <button type="button" class="kk-mock-h" data-kk-mock-h="1" hidden aria-label="{{ 'kk.studio.corner' | t: n: 2 }}"></button>
          <button type="button" class="kk-mock-h" data-kk-mock-h="2" hidden aria-label="{{ 'kk.studio.corner' | t: n: 3 }}"></button>
          <button type="button" class="kk-mock-h" data-kk-mock-h="3" hidden aria-label="{{ 'kk.studio.corner' | t: n: 4 }}"></button>
        </div>
      </div>

      <aside class="kk-mock-side">
        <div class="kk-tool">
          <span class="kk-tool-lab">{{ 'kk.studio.preview' | t }}</span>
          <div class="kk-mview" role="group" aria-label="{{ 'kk.studio.preview_mode' | t }}">
            <button type="button" class="kk-btn kk-mview-btn is-on" data-kk-mview="threed">3D</button>
            <button type="button" class="kk-btn kk-mview-btn" data-kk-mview="photo">{{ 'kk.studio.photo' | t }}</button>
          </div>
          <div class="kk-mview" data-kk-mface-row hidden role="group" aria-label="{{ 'kk.studio.label_side' | t }}">
            <button type="button" class="kk-btn kk-mview-btn is-on" data-kk-mface="front">{{ 'kk.studio.front' | t }}</button>
            <button type="button" class="kk-btn kk-mview-btn" data-kk-mface="back">{{ 'kk.studio.back' | t }}</button>
          </div>
          <button type="button" class="kk-tool-btn" data-kk-mock-close>{{ 'kk.studio.back_to_editor' | t }}</button>
          <button type="button" class="kk-tool-btn" data-kk-mock-dl>{{ 'kk.studio.download_png' | t }}</button>
          <button type="button" class="kk-tool-btn" data-kk-mock-attach>{{ 'kk.studio.attach_order' | t }}</button>
          <p class="kk-hint kk-hint--ok" data-kk-mock-note hidden></p>
          <p class="kk-tool-hint" data-kk-mock-hint-3d>
            {{ 'kk.studio.hint_3d' | t }}
          </p>
          <p class="kk-tool-hint" data-kk-mock-hint-photo hidden>
            {{ 'kk.studio.hint_photo' | t }}
          </p>
        </div>

        <div class="kk-tool" data-kk-mock-cal hidden>
          <span class="kk-tool-lab">{{ 'kk.studio.calibration' | t }}</span>
          <p class="kk-tool-hint">{{ 'kk.studio.cal_hint' | t }}</p>
          <div class="kk-field"><span>{{ 'kk.studio.wrap' | t }}</span><input type="range" min="0" max="120" data-kk-mock-p="wrap"></div>
          <div class="kk-field"><span>{{ 'kk.studio.bulge' | t }}</span><input type="range" min="-12" max="12" data-kk-mock-p="bulge"></div>
          <div class="kk-field"><span>{{ 'kk.studio.shade' | t }}</span><input type="range" min="0" max="80" data-kk-mock-p="shade"></div>
          <div class="kk-field"><span>{{ 'kk.studio.shine' | t }}</span><input type="range" min="0" max="60" data-kk-mock-p="shine"></div>
          <textarea class="kk-mock-json" data-kk-mock-json rows="4" readonly></textarea>
          <button type="button" class="kk-tool-btn" data-kk-mock-copy>{{ 'kk.studio.copy_json' | t }}</button>
          <p class="kk-tool-hint">
            {{ 'kk.studio.cal_paste_html' | t }}
          </p>
        </div>
      </aside>
    </div>

    {%- comment -%}
      Bara de jos rămâne doar pentru ecrane mici, unde cea de sus n-are loc
      pentru toate acțiunile.
    {%- endcomment -%}
    <div class="kk-studio-foot">
      <button type="button" class="kk-btn" data-kk-studio-close>{{ 'kk.studio.cancel' | t }}</button>
      <button type="button" class="kk-btn kk-btn--solid" data-kk-studio-done>{{ 'kk.studio.use_design' | t }}</button>
    </div>
  </div>
