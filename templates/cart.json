      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  KOSMETIKAL — MOQ pe pagina de coș (V1)\n\n  SECȚIUNE \"Custom Liquid\" pe template-ul Cart.\n  Theme Editor → selectorul de pagină → Cart → Add section → Custom Liquid.\n  Poziția în pagină nu contează (nu randează nimic vizibil în plus).\n\n  Ce face: împiedică scăderea cantității sub prag din steperele coșului\n  și afișează o notă când cineva încearcă.\n\n  ⚠️ Rămâne validare de interfață. Un apel direct la API o ocolește.\n     Varianta care nu se poate ocoli = Shopify Function (V2).\n\n  Butonul de ștergere a liniei NU e afectat — se poate goli coșul normal.\n{%- endcomment -%}\n\n{%- assign kk_moq = 10 -%}\n\n<div data-kk-cart-moq data-moq=\"{{ kk_moq }}\" hidden></div>\n\n<style>\n  .kk-moq-note {\n    margin: .8rem 0 0; font-size: 1.2rem; line-height: 1.4;\n    color: rgb(var(--color-foreground)); opacity: .75;\n  }\n  .kk-moq-note strong { opacity: 1; }\n</style>\n\n<script>\n(function () {\n  var host = document.querySelector('[data-kk-cart-moq]');\n  if (!host) return;\n  var MOQ = parseInt(host.dataset.moq, 10);\n\n  function cartQtyInputs() {\n    return Array.prototype.filter.call(\n      document.querySelectorAll('input.quantity__input, input[name=\"updates[]\"]'),\n      function (i) { return i.closest('cart-items, .cart-items, #main-cart-items, cart-drawer'); }\n    );\n  }\n\n  function note(input) {\n    var wrap = input.closest('quantity-input') || input.parentElement;\n    var holder = wrap && wrap.parentElement;\n    if (!holder) return;\n    var el = holder.querySelector('.kk-moq-note');\n    if (!el) {\n      el = document.createElement('p');\n      el.className = 'kk-moq-note';\n      el.innerHTML = 'Minimum order is <strong>' + MOQ + ' pieces</strong> — the smallest production batch. ' +\n                     'To remove this item, use the bin icon.';\n      holder.appendChild(el);\n    }\n    el.style.display = '';\n    clearTimeout(el._t);\n    el._t = setTimeout(function () { el.style.display = 'none'; }, 6000);\n  }\n\n  function apply() {\n    cartQtyInputs().forEach(function (input) {\n      if (input.dataset.kkBound) { input.min = MOQ; return; }\n      input.dataset.kkBound = '1';\n      input.min = MOQ;   // stepDown() al lui Dawn respectă min, deci butonul „−\" se oprește singur\n\n      // tastare manuală: corectăm înainte ca Dawn să citească valoarea\n      input.addEventListener('change', function (e) {\n        var v = parseInt(input.value, 10);\n        if (!isNaN(v) && v > 0 && v < MOQ) {\n          input.value = MOQ;\n          note(input);\n          e.stopImmediatePropagation();\n          input.dispatchEvent(new Event('change', { bubbles: true }));\n        }\n      }, true);\n\n      // click pe „−\" când e deja la prag\n      var minus = input.parentElement && input.parentElement.querySelector('[name=\"minus\"]');\n      if (minus) {\n        minus.addEventListener('click', function () {\n          if (parseInt(input.value, 10) <= MOQ) note(input);\n        });\n      }\n    });\n  }\n\n  apply();\n  // Dawn re-randează coșul după fiecare update AJAX → re-legăm inputurile\n  new MutationObserver(apply).observe(document.body, { childList: true, subtree: true });\n})();\n</script>",
        "color_scheme": "",
