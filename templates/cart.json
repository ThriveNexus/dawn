      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  KOSMETIKAL — Cantitate minimă și multiplu de bax, pe pagina de coș\n\n  SECȚIUNE \"Custom Liquid\" pe template-ul Cart.\n  Theme Editor → selectorul de pagină → Cart → Add section → Custom Liquid.\n  Poziția în pagină nu contează (nu randează nimic vizibil în plus).\n\n  Regulile se citesc PER LINIE din coș: fiecare produs își poate avea propriul\n  minim și propriul multiplu de bax, la fel ca pe pagina de produs.\n\n  ⚠️ Rămâne validare de interfață. Un apel direct la API o ocolește.\n     Varianta care nu se poate ocoli = Shopify Function (V2).\n\n  Butonul de ștergere a liniei NU e afectat — coșul se poate goli normal.\n{%- endcomment -%}\n\n<div data-kk-cart-moq hidden>\n  <script type=\"application/json\" data-kk-rules>\n    [\n    {%- for item in cart.items -%}\n      {%- assign im = item.product.metafields.custom -%}\n      {%- assign li_moq  = im.moq.value | default: settings.kk_moq | default: 10 -%}\n      {%- assign li_mult = im.case_multiple.value | default: settings.kk_case_multiple | default: 1 -%}\n      {%- assign li_mult = li_mult | plus: 0 -%}\n      {%- if li_mult < 1 -%}{%- assign li_mult = 1 -%}{%- endif -%}\n      {%- assign li_cases = li_moq | divided_by: li_mult -%}\n      {%- assign li_exact = li_cases | times: li_mult -%}\n      {%- if li_exact < li_moq -%}{%- assign li_cases = li_cases | plus: 1 -%}{%- endif -%}\n      {%- assign li_casemin = li_cases | times: li_mult -%}\n      {%- if settings.kk_allow_single -%}{%- assign li_min = 1 -%}{%- else -%}{%- assign li_min = li_casemin -%}{%- endif -%}\n      {\"i\":{{ forloop.index }},\"min\":{{ li_min }},\"casemin\":{{ li_casemin }},\"mult\":{{ li_mult }}}{%- unless forloop.last -%},{%- endunless -%}\n    {%- endfor -%}\n    ]\n  </script>\n</div>\n\n<style>\n  /* Bandă la lățime întreagă, deasupra liniilor din coș.\n     NU se pune în celula de cantitate — acolo strivește steperul. */\n  .kk-moq-note {\n    margin: 0 0 2rem; padding: 1.2rem 1.6rem;\n    font-size: 1.3rem; line-height: 1.5;\n    border-left: 3px solid rgb(var(--color-foreground));\n    background: rgba(var(--color-foreground), .06);\n  }\n  .kk-moq-note strong { font-weight: 600; }\n</style>\n\n<script>\n(function () {\n  var host = document.querySelector('[data-kk-cart-moq]');\n  if (!host) return;\n\n  var rules = {};\n  try {\n    JSON.parse(host.querySelector('[data-kk-rules]').textContent)\n      .forEach(function (r) { rules[r.i] = r; });\n  } catch (e) { return; }\n\n  function cartQtyInputs() {\n    return Array.prototype.filter.call(\n      document.querySelectorAll('input.quantity__input, input[name=\"updates[]\"]'),\n      function (i) { return i.closest('cart-items, .cart-items, #main-cart-items, cart-drawer'); }\n    );\n  }\n\n  function ruleFor(input) {\n    var idx = parseInt(input.dataset.index || input.getAttribute('data-index'), 10);\n    return rules[idx] || rules[1] || null;\n  }\n\n  function note(r) {\n    var anchor = document.querySelector('cart-items, #main-cart-items, .cart__items');\n    if (!anchor) return;\n    var el = document.getElementById('kk-moq-note');\n    if (!el || !el.isConnected) {\n      el = document.createElement('p');\n      el.id = 'kk-moq-note';\n      el.className = 'kk-moq-note';\n      anchor.parentNode.insertBefore(el, anchor);\n    }\n    var msg = 'Minimum order is <strong>' + r.min + ' pieces</strong> — the smallest production batch.';\n    if (r.mult > 1) msg += ' This product is sold in cases of <strong>' + r.mult + '</strong>.';\n    msg += ' To remove an item, use the bin icon.';\n    el.innerHTML = msg;\n    el.style.display = '';\n    clearTimeout(el._t);\n    el._t = setTimeout(function () { el.style.display = 'none'; }, 6000);\n  }\n\n  /* aliniază la minim și la multiplul de bax */\n  function snap(n, r) {\n    if (isNaN(n) || n <= 0) return r.min;\n    if (r.min === 1 && n <= 1) return 1;\n    if (n < r.casemin) return r.casemin;\n    if (r.mult <= 1) return n;\n    var k = Math.round((n - r.casemin) / r.mult);\n    var v = r.casemin + k * r.mult;\n    return v < r.casemin ? r.casemin : v;\n  }\n\n  function apply() {\n    cartQtyInputs().forEach(function (input) {\n      var r = ruleFor(input);\n      if (!r) return;\n\n      // stepDown() al lui Dawn respectă min, deci butonul „−\" se oprește singur\n      input.min = r.min;\n      if (r.mult > 1) input.step = r.mult;\n\n      if (input.dataset.kkBound) return;\n      input.dataset.kkBound = '1';\n\n      input.addEventListener('change', function (e) {\n        var v = parseInt(input.value, 10);\n        var s = snap(v, r);\n        if (v !== s) {\n          input.value = s;\n          note(r);\n          e.stopImmediatePropagation();\n          input.dispatchEvent(new Event('change', { bubbles: true }));\n        }\n      }, true);\n\n      var minus = input.parentElement && input.parentElement.querySelector('[name=\"minus\"]');\n      if (minus) {\n        minus.addEventListener('click', function () {\n          if (parseInt(input.value, 10) <= r.min) note(r);\n        });\n      }\n    });\n  }\n\n  apply();\n  // Dawn re-randează coșul după fiecare update AJAX → re-legăm inputurile\n  new MutationObserver(apply).observe(document.body, { childList: true, subtree: true });\n})();\n</script>",
