        "custom_liquid_fVPCye": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  KOSMETIKAL — Panou B2B pentru pagina de produs (V1)\n  Se lipește într-un bloc \"Custom Liquid\" din secțiunea Product information,\n  imediat sub Variant picker.\n\n  Blocurile native \"Price\" și \"Quantity selector\" trebuie ASCUNSE — le înlocuiește ăsta.\n  Blocul \"Buy buttons\" rămâne activ (are nevoie de el formularul).\n\n  Praguri: se schimbă în cele două linii de mai jos.\n{%- endcomment -%}\n\n{%- assign kk_moq = 10 -%}\n{%- assign kk_cap = 500 -%}\n\n<div class=\"kk-panel\" data-kk-panel data-kk-moq=\"{{ kk_moq }}\" data-kk-cap=\"{{ kk_cap }}\">\n\n  <script type=\"application/json\" data-kk-variants>\n    [{% for v in product.variants %}{\"id\":{{ v.id }},\"price\":{{ v.price }}}{% unless forloop.last %},{% endunless %}{% endfor %}]\n  </script>\n\n  <div class=\"kk-row\">\n    <span class=\"kk-lab\">Price / 1 pcs</span>\n    <span class=\"kk-val\" data-kk-unit>{{ product.selected_or_first_available_variant.price | money }}</span>\n  </div>\n\n  <div class=\"kk-row\">\n    <span class=\"kk-lab\">Min. order qty.</span>\n    <span class=\"kk-val kk-val--sm\">{{ kk_moq }} PCS</span>\n  </div>\n  <p class=\"kk-note\">Smallest real production batch — made to order in Italy.</p>\n\n  <div class=\"kk-row\">\n    <span class=\"kk-lab\">Quantity</span>\n    <span class=\"kk-stepper\">\n      <button type=\"button\" data-kk-minus aria-label=\"Decrease quantity\">&minus;</button>\n      <input type=\"number\" data-kk-qty value=\"{{ kk_moq }}\" min=\"{{ kk_moq }}\" step=\"1\" inputmode=\"numeric\">\n      <button type=\"button\" data-kk-plus aria-label=\"Increase quantity\">+</button>\n    </span>\n  </div>\n\n  <div class=\"kk-row kk-row--total\">\n    <span class=\"kk-lab\">Your total</span>\n    <span class=\"kk-val\" data-kk-total></span>\n  </div>\n\n  <p class=\"kk-over\" data-kk-over hidden>\n    Over {{ kk_cap }} pieces goes through our wholesale process.\n    <a href=\"/pages/contact\">Request a quote &rarr;</a>\n  </p>\n\n  <p class=\"kk-trust\">\n    Made in Italy &middot; Certified organic &middot; Design reviewed before production\n  </p>\n</div>\n\n<style>\n  .kk-panel { margin: 2.4rem 0; }\n\n  .kk-row {\n    display: flex; align-items: baseline; justify-content: space-between;\n    gap: 1.6rem; padding: 1.4rem 0;\n    border-bottom: 1px solid rgba(var(--color-foreground), 0.12);\n  }\n  .kk-lab {\n    font-size: 1.1rem; letter-spacing: .08em; text-transform: uppercase;\n    opacity: .65; white-space: nowrap;\n  }\n  .kk-val { font-size: 2.8rem; line-height: 1.1; font-weight: 400; }\n  .kk-val--sm { font-size: 2.2rem; }\n  .kk-row--total .kk-val { font-size: 2.2rem; }\n\n  .kk-note {\n    margin: .6rem 0 0; font-size: 1.2rem; opacity: .55; text-align: right;\n  }\n\n  .kk-stepper { display: inline-flex; align-items: center; }\n  .kk-stepper button {\n    width: 4rem; height: 4rem; font-size: 1.8rem; cursor: pointer;\n    background: none; color: inherit;\n    border: 1px solid rgba(var(--color-foreground), 0.2);\n  }\n  .kk-stepper button:hover { background: rgba(var(--color-foreground), 0.05); }\n  .kk-stepper input {\n    width: 7rem; height: 4rem; text-align: center; font-size: 1.6rem;\n    background: none; color: inherit;\n    border: 1px solid rgba(var(--color-foreground), 0.2); border-left: 0; border-right: 0;\n    -moz-appearance: textfield;\n  }\n  .kk-stepper input::-webkit-outer-spin-button,\n  .kk-stepper input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }\n\n  .kk-over {\n    margin: 1.4rem 0 0; padding: 1.2rem 1.4rem; font-size: 1.3rem;\n    background: rgba(var(--color-foreground), 0.05);\n  }\n  .kk-over a { font-weight: 600; }\n\n  .kk-trust { margin: 1.6rem 0 0; font-size: 1.2rem; opacity: .6; }\n\n  @media screen and (max-width: 749px) {\n    .kk-val { font-size: 2.2rem; }\n    .kk-row { padding: 1.1rem 0; }\n  }\n</style>\n\n<script>\n(function () {\n  var panel = document.querySelector('[data-kk-panel]');\n  if (!panel) return;\n\n  var MOQ = parseInt(panel.dataset.kkMoq, 10);\n  var CAP = parseInt(panel.dataset.kkCap, 10);\n  var variants = JSON.parse(panel.querySelector('[data-kk-variants]').textContent);\n\n  var qtyInput  = panel.querySelector('[data-kk-qty]');\n  var unitEl    = panel.querySelector('[data-kk-unit]');\n  var totalEl   = panel.querySelector('[data-kk-total]');\n  var overEl    = panel.querySelector('[data-kk-over]');\n\n  // formular de produs Dawn + inputurile lui native\n  var form       = panel.closest('form[action*=\"/cart/add\"]') || document.querySelector('form[action*=\"/cart/add\"]');\n  var nativeQty  = form && form.querySelector('input[name=\"quantity\"]');\n  var nativeId   = form && form.querySelector('[name=\"id\"]');\n  var addButton  = form && form.querySelector('[name=\"add\"]');\n\n  function money(cents) {\n    return '€' + (cents / 100).toFixed(2).replace('.', ',');\n  }\n\n  function currentVariant() {\n    var id = nativeId ? parseInt(nativeId.value, 10) : null;\n    for (var i = 0; i < variants.length; i++) {\n      if (variants[i].id === id) return variants[i];\n    }\n    return variants[0];\n  }\n\n  function render() {\n    var v   = currentVariant();\n    var qty = parseInt(qtyInput.value, 10);\n    if (isNaN(qty)) qty = MOQ;\n\n    if (qty < MOQ) qty = MOQ;\n    qtyInput.value = qty;\n\n    unitEl.textContent  = money(v.price);\n    totalEl.textContent = money(v.price * qty);\n\n    var over = qty > CAP;\n    overEl.hidden = !over;\n    if (addButton) {\n      addButton.disabled = over;\n      addButton.style.opacity = over ? '.4' : '';\n    }\n\n    if (nativeQty) nativeQty.value = qty;   // ține formularul sincronizat\n  }\n\n  panel.querySelector('[data-kk-minus]').addEventListener('click', function () {\n    qtyInput.value = parseInt(qtyInput.value, 10) - 1; render();\n  });\n  panel.querySelector('[data-kk-plus]').addEventListener('click', function () {\n    qtyInput.value = parseInt(qtyInput.value, 10) + 1; render();\n  });\n  qtyInput.addEventListener('input', render);\n  qtyInput.addEventListener('blur', render);\n\n  // Dawn schimbă varianta rescriind inputul ascuns \"id\" — îl urmărim\n  if (nativeId) {\n    new MutationObserver(render).observe(nativeId, { attributes: true, attributeFilter: ['value'] });\n    nativeId.addEventListener('change', render);\n  }\n  if (form) form.addEventListener('change', render);\n\n  render();\n})();\n</script>"
