        "custom_liquid_mnWCT9": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  KOSMETIKAL — Cele trei butoane (V1)\n\n  BLOC \"Custom Liquid\" în secțiunea Product information,\n  plasat IMEDIAT SUB blocul \"Buy buttons\".\n\n  Order Sample  → link (V1: pagina de contact)\n  Add Design    → deschide upload-ul; fișierul se atașează pe comandă\n                  ca line item property, fără niciun app\n  Calculator    → tabel static cu praguri (citește prețul din panoul B2B)\n\n  ⚠️ „Show dynamic checkout buttons\" (Buy with Shop) TREBUIE oprit din blocul Buy buttons.\n{%- endcomment -%}\n\n{%- assign kk_retail_x = 3.5 -%}\n\n<div class=\"kk-cta\" data-kk-cta data-kk-retail=\"{{ kk_retail_x }}\">\n\n  <div class=\"kk-cta-row\">\n    <a class=\"kk-btn kk-btn--ghost\" href=\"/pages/contact\">Order sample</a>\n    <button type=\"button\" class=\"kk-btn kk-btn--solid\" data-kk-design-toggle>\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n        <path d=\"M12 19l7-7 3 3-7 7-3-3z\"/><path d=\"M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z\"/>\n      </svg>\n      Add design\n    </button>\n  </div>\n\n  <button type=\"button\" class=\"kk-btn kk-btn--wide\" data-kk-calc-toggle>\n    Bulk &amp; profit calculator\n  </button>\n\n  <div class=\"kk-drawer\" data-kk-design hidden>\n    <label class=\"kk-drawer-lab\" for=\"kk-file\">Upload your logo or label</label>\n    <input type=\"file\" id=\"kk-file\" name=\"properties[Design]\"\n           accept=\".png,.jpg,.jpeg,.pdf,.ai,.eps,.svg\" data-kk-file>\n    <p class=\"kk-hint\">PNG, JPG, PDF, AI, EPS or SVG &middot; max 20&nbsp;MB</p>\n    <p class=\"kk-hint kk-hint--ok\" data-kk-ok hidden>\n      &check; Attached. Your design is reviewed and confirmed before production.\n    </p>\n  </div>\n\n  <div class=\"kk-drawer\" data-kk-calc hidden>\n    <table class=\"kk-table\">\n      <thead>\n        <tr><th>Quantity</th><th>Your cost / pc</th><th>Suggested retail</th><th>Your margin</th></tr>\n      </thead>\n      <tbody data-kk-rows></tbody>\n    </table>\n    <p class=\"kk-hint\">Indicative figures. Final pricing is confirmed with your order.</p>\n  </div>\n\n</div>\n\n<style>\n  .kk-cta { margin: 1.6rem 0 0; }\n  .kk-cta-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }\n\n  .kk-btn {\n    display: inline-flex; align-items: center; justify-content: center; gap: .8rem;\n    padding: 1.5rem 1.8rem; font-size: 1.4rem; letter-spacing: .04em;\n    text-decoration: none; cursor: pointer; border: 1px solid rgb(var(--color-foreground));\n    background: none; color: rgb(var(--color-foreground)); text-align: center;\n  }\n  .kk-btn--solid { background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); }\n  .kk-btn--ghost { background: rgba(var(--color-foreground), .06); border-color: transparent; }\n  .kk-btn--wide { width: 100%; margin-top: 1rem; }\n  .kk-btn:hover { opacity: .85; }\n\n  .kk-drawer {\n    margin-top: 1.4rem; padding: 1.8rem;\n    border: 1px solid rgba(var(--color-foreground), .18);\n  }\n  .kk-drawer-lab { display: block; margin-bottom: 1rem; font-size: 1.4rem; font-weight: 600; }\n  .kk-drawer input[type=\"file\"] { width: 100%; font-size: 1.3rem; }\n  .kk-hint { margin: 1rem 0 0; font-size: 1.2rem; opacity: .6; }\n  .kk-hint--ok { opacity: 1; font-weight: 600; }\n\n  .kk-table { width: 100%; border-collapse: collapse; font-size: 1.3rem; }\n  .kk-table th, .kk-table td { padding: .9rem .4rem; text-align: right; }\n  .kk-table th:first-child, .kk-table td:first-child { text-align: left; }\n  .kk-table thead th {\n    font-size: 1.05rem; letter-spacing: .08em; text-transform: uppercase;\n    opacity: .55; font-weight: 400;\n    border-bottom: 1px solid rgba(var(--color-foreground), .18);\n  }\n  .kk-table tbody tr { border-bottom: 1px solid rgba(var(--color-foreground), .08); }\n\n  @media screen and (max-width: 749px) {\n    .kk-cta-row { grid-template-columns: 1fr; }\n    .kk-table { font-size: 1.2rem; }\n  }\n</style>\n\n<script>\n(function () {\n  var cta = document.querySelector('[data-kk-cta]');\n  if (!cta) return;\n\n  /* Pagina are mai multe formulare către /cart/add (Dawn adaugă și unul de rate).\n     Îl vrem pe cel care conține butonul Add to cart. */\n  function productForm() {\n    var fs = document.querySelectorAll('form[action*=\"/cart/add\"]');\n    for (var i = 0; i < fs.length; i++) {\n      if (fs[i].querySelector('[name=\"add\"]')) return fs[i];\n    }\n    return fs[0] || null;\n  }\n\n  var form = productForm();\n  var file = cta.querySelector('[data-kk-file]');\n  var okEl = cta.querySelector('[data-kk-ok]');\n\n  /* Mutăm fizic blocul în formular. Atributul form=\"\" e nesigur când există mai multe\n     formulare; înăuntru, inputul e garantat trimis. Vizual rămâne în același loc. */\n  if (form) {\n    form.setAttribute('enctype', 'multipart/form-data');\n    form.appendChild(cta);\n\n    /* Plasă de siguranță pentru cantitate: blocul nativ \"Quantity selector\" e ascuns,\n       deci inputul lui nu există și Shopify ar trimite 1. Îl garantăm aici, sincronizat\n       cu steperul din panoul B2B — independent de ce face celălalt bloc. */\n    var qtyField = form.querySelector('input[name=\"quantity\"]');\n    if (!qtyField) {\n      qtyField = document.createElement('input');\n      qtyField.type = 'hidden';\n      qtyField.name = 'quantity';\n      form.appendChild(qtyField);\n    }\n    var panelQty = document.querySelector('[data-kk-qty]');\n    function syncQty() { qtyField.value = panelQty ? panelQty.value : 1; }\n    if (panelQty) {\n      panelQty.addEventListener('input', syncQty);\n      panelQty.addEventListener('change', syncQty);\n      new MutationObserver(syncQty).observe(panelQty, { attributes: true, attributeFilter: ['value'] });\n      document.addEventListener('click', function (e) {\n        if (e.target.closest('[data-kk-minus],[data-kk-plus]')) setTimeout(syncQty, 0);\n      });\n    }\n    syncQty();\n  }\n\n  file.addEventListener('change', function () {\n    var has = file.files && file.files.length > 0;\n    okEl.hidden = !has;\n    var label = form && form.querySelector('[name=\"add\"] span');\n    if (label) label.textContent = has ? 'Add to cart with my design' : 'Add to cart';\n  });\n\n  /* --- API-ul AJAX de coș al Shopify NU acceptă fișiere. Când există un design atașat,\n         ocolim handlerul lui Dawn și facem submit nativ (POST multipart real).\n         form.submit() nu declanșează evenimentul \"submit\", deci Dawn nu intervine. --- */\n  var addBtn = form && form.querySelector('[name=\"add\"]');\n  if (addBtn) {\n    addBtn.addEventListener('click', function (e) {\n      if (file.files && file.files.length > 0) {\n        e.preventDefault();\n        e.stopImmediatePropagation();\n        form.submit();\n      }\n    }, true);\n  }\n\n  /* --- sertare --- */\n  function toggle(el) { el.hidden = !el.hidden; }\n  cta.querySelector('[data-kk-design-toggle]').addEventListener('click', function () {\n    toggle(cta.querySelector('[data-kk-design]'));\n  });\n  cta.querySelector('[data-kk-calc-toggle]').addEventListener('click', function () {\n    var d = cta.querySelector('[data-kk-calc]');\n    toggle(d);\n    if (!d.hidden) rows();\n  });\n\n  /* --- calculator: citește prețul curent din panoul B2B, deci rămâne sincron --- */\n  var TIERS  = [ {q: 10, off: 0}, {q: 100, off: .12}, {q: 500, off: .22} ];\n  var RETAIL = parseFloat(cta.dataset.kkRetail);\n\n  function unitCents() {\n    var el = document.querySelector('[data-kk-unit]');\n    if (!el) return 0;\n    return Math.round(parseFloat(el.textContent.replace(/[^\\d,.]/g, '').replace(',', '.')) * 100);\n  }\n  function money(c) { return '€' + (c / 100).toFixed(2).replace('.', ','); }\n\n  function rows() {\n    var base = unitCents();\n    if (!base) return;\n    cta.querySelector('[data-kk-rows]').innerHTML = TIERS.map(function (t) {\n      var cost   = Math.round(base * (1 - t.off));\n      var retail = Math.round(cost * RETAIL / 100) * 100;\n      var margin = Math.round((retail - cost) / retail * 100);\n      return '<tr><td>' + t.q + ' pcs</td><td>' + money(cost) + '</td><td>'\n           + money(retail) + '</td><td>' + margin + '%</td></tr>';\n    }).join('');\n  }\n})();\n</script>"
