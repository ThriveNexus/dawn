{%- comment -%}
  KOSMETIKAL — Întrebări frecvente (secțiunea 15 din landing V2).
  Acordeon nativ (details/summary), o întrebare = un bloc; prima poate fi
  deschisă implicit. În răspunsuri, __floor__ și __cap__ sunt înlocuite cu
  minimul de comandă și pragul de ofertă calculate din produse. Sloturile
  goale din V2 (termen de livrare, păstrarea artwork-ului) nu apar.
  Emite și date structurate FAQPage pentru Google.
{%- endcomment -%}
{{ 'kk-landing.css' | asset_url | stylesheet_tag }}
{%- capture kk_floor -%}{%- render 'kk-order-floor' -%}{%- endcapture -%}
{%- assign kk_floor = kk_floor | strip | plus: 0 -%}
{%- capture kk_cap -%}{%- render 'kk-order-cap' -%}{%- endcapture -%}
{%- assign kk_cap = kk_cap | strip | plus: 0 -%}

<div class="kk-faq color-{{ section.settings.color_scheme }} gradient" style="--kk-pt: {{ section.settings.padding_top }}px; --kk-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="kk-faq__in">
      {%- if section.settings.heading != blank -%}
        <div class="kk-section-head">
          <h2 class="kk-h2">{{ section.settings.heading | escape }}</h2>
        </div>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.question == blank -%}{%- continue -%}{%- endif -%}
        {%- assign kk_answer = block.settings.answer | replace: '__floor__', kk_floor | replace: '__cap__', kk_cap -%}
        <details class="kk-faq__item" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
          <summary class="kk-faq__q">
            <span>{{ block.settings.question | escape }}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="kk-faq__a">{{ kk_answer | escape | newline_to_br }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.structured_data and section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {%- if block.settings.question == blank -%}{%- continue -%}{%- endif -%}
        {%- assign kk_answer = block.settings.answer | replace: '__floor__', kk_floor | replace: '__cap__', kk_cap -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ kk_answer | json }} }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Kosmetikal · FAQ",
  "tag": "section",
  "class": "kk-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "What everyone asks before a first batch."
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "Send the questions to Google as structured data (FAQPage)",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is the minimum order?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "info": "__floor__ = the order minimum, __cap__ = the quote threshold, both computed from the products.", "default": "__floor__ pieces per product. The panel on every product page enforces it and corrects the quantity for you, and the price ladder above shows what each step costs." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Kosmetikal · FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "What is the minimum order?", "answer": "__floor__ pieces per product. The panel on every product page enforces it and corrects the quantity for you, and the price ladder above shows what each step costs.", "open": true } },
        { "type": "qa", "settings": { "question": "If my name is on the label, am I the one the authorities call?", "answer": "Yes, and that is normal: under European cosmetics law the Responsible Person is whoever appears on the pack. What changes is how much of the work lands on you. We hold the product file and the safety assessment because we made the formula, we give you the label wording your product needs, and we can file the notification in your name if you would rather not do it yourself." } },
        { "type": "qa", "settings": { "question": "Who checks my design?", "answer": "A person at the laboratory. We check print quality, the mandatory label information and the fit for your chosen container. If something is off, we contact you before anything is produced." } },
        { "type": "qa", "settings": { "question": "What happens to the artwork I upload?", "answer": "It stays yours. We use it to print your labels and for nothing else, we do not show it to anyone, and we keep it on file so your reorder does not start from zero." } },
        { "type": "qa", "settings": { "question": "How long does a first batch take?", "answer": "We confirm the production date when we confirm your design. If part of your order is already in stock, that part ships first and the rest follows, and you see both dates before you pay." } },
        { "type": "qa", "settings": { "question": "Can you also develop a custom formula?", "answer": "Above __cap__ pieces, yes. Everything in this store is white label: ready, tested formulas with your label on them. At contract scale our R&D team can develop a formula of your own, and that route starts with a quote request rather than in the store." } }
      ]
    }
  ]
}
{% endschema %}
