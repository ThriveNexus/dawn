{%- comment -%}
  KOSMETIKAL — „Despre laborator” (secțiunea 13 din landing V2).
  Doar textul, dimensionat cât imaginea de alături (fișa de fapte a fost scoasă
  de Claudio). Fără an de înființare: nu există în niciun document. Fotografia
  laboratorului nu e încă disponibilă; până vine, în dreapta stă un cadru
  schițat cu o etichetă, ca să se vadă locul ei. Ține ancora #why.
{%- endcomment -%}
{{ 'kk-landing.css' | asset_url | stylesheet_tag }}

<div id="why" class="kk-maker color-{{ section.settings.color_scheme }} gradient" style="--kk-pt: {{ section.settings.padding_top }}px; --kk-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width kk-maker__grid">
    <div class="kk-maker__copy">
      {%- if section.settings.heading != blank -%}
        <h2 class="kk-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="kk-maker__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <figure class="kk-maker__frame">
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.image.alt | default: '' }}
      </figure>
    {%- elsif section.settings.show_placeholder -%}
      <div class="kk-maker__frame kk-maker__frame--empty" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-8 8"/></svg>
        {%- if section.settings.placeholder_text != blank -%}
          <span>{{ section.settings.placeholder_text | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kosmetikal · The maker",
  "tag": "section",
  "class": "kk-maker-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Work directly with the laboratory that makes your products."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Kosmetikal is a <strong>cosmetics contract manufacturer</strong> of natural and organic cosmetics. We make cosmetic lines for other brands, and those lines are now available in small quantities too.</p><p>Our R&amp;D staff combines experience and creativity to ensure innovative, safe and high quality formulations, working with leading raw materials companies and <strong>Italian universities</strong>.</p><p>Because every formula is developed and produced here in Pesaro, your product's documentation comes <strong>from the source</strong>.</p>"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Laboratory photo",
      "info": "Not available yet. Until then, a sketched frame marks its place."
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show the sketched frame when there is no photo",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Text in the frame",
      "default": "Laboratory photo, Pesaro"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "presets": [{ "name": "Kosmetikal · The maker" }]
}
{% endschema %}
