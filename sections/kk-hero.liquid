{%- comment -%}
  KOSMETIKAL — Hero (secțiunea 3 din landing V2).
  Toate textele sunt setări (editabile și traductibile din editorul de temă).
  „From N pieces” vine din snippet-ul kk-order-floor. Fotografia e opțională:
  pe desktop se pune cu un voal deschis peste ea, pe telefon dispare.
  Al doilea buton fără link se randează doar vizual, fără acțiune.
{%- endcomment -%}
{{ 'kk-landing.css' | asset_url | stylesheet_tag }}
{%- capture kk_floor -%}{%- render 'kk-order-floor' -%}{%- endcapture -%}
{%- assign kk_floor = kk_floor | strip | plus: 0 -%}
{%- assign kk_img = section.settings.image -%}

<div
  class="kk-hero color-{{ section.settings.color_scheme }} gradient{% if kk_img != blank %} kk-hero--photo{% endif %}"
  style="--kk-pt: {{ section.settings.padding_top }}px; --kk-pb: {{ section.settings.padding_bottom }}px;{% if kk_img != blank %} --kk-hero-img: url('{{ kk_img | image_url: width: 2200 }}');{% endif %}"
>
  <div class="page-width kk-hero__in">
    <div class="kk-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kk-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="kk-hero__title">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="kk-hero__sub rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.show_floor -%}
        <p class="kk-hero__floor">
          <b>{{ 'kk.landing.from_pieces' | t: n: kk_floor }}</b>
          {%- if section.settings.floor_suffix != blank -%}
            <span>{{ section.settings.floor_suffix | escape }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
        <div class="kk-hero__ctas">
          {%- if section.settings.button_label != blank -%}
            <a class="kk-btn kk-btn--solid" href="{{ section.settings.button_link | default: '/collections' }}">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            {%- if section.settings.button2_link != blank -%}
              <a class="kk-btn kk-btn--ghost" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label | escape }}</a>
            {%- else -%}
              <span class="kk-btn kk-btn--ghost kk-btn--inert">{{ section.settings.button2_label | escape }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.show_trust and section.settings.trust_text != blank -%}
        <p class="kk-hero__trust">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <span>{{ section.settings.trust_text | escape }}</span>
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kosmetikal · Hero",
  "tag": "section",
  "class": "kk-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the title",
      "default": "Cosmetics contract manufacturer · Pesaro, Italy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Your brand, from our laboratory in Italy."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Formulas developed and produced in our own laboratory, with ICEA and AIAB certified organic lines among them. Choose a ready formula, add your label, order a small batch.</p>"
    },
    {
      "type": "header",
      "content": "Order minimum"
    },
    {
      "type": "checkbox",
      "id": "show_floor",
      "label": "Show “From N pieces”",
      "info": "N is computed from the products: the smallest quantity that can actually be ordered. Not typed by hand.",
      "default": true
    },
    {
      "type": "text",
      "id": "floor_suffix",
      "label": "Text after the number",
      "default": "per product, with your own label on them"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Main button",
      "default": "Browse the catalogue"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Main button link",
      "default": "/collections"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Second button",
      "default": "See it with your name on it"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Second button link",
      "info": "Leave empty to show the button without any action."
    },
    {
      "type": "header",
      "content": "Trust line"
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show the trust line",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust line",
      "default": "Every design is reviewed and confirmed before production."
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background photo (optional)",
      "info": "Shown on desktop behind a light veil. Hidden on phones."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "presets": [{ "name": "Kosmetikal · Hero" }]
}
{% endschema %}
