{%- comment -%}
  KOSMETIKAL — Închiderea paginii (secțiunea 16 din landing V2).
  Titlu, un rând de text, două butoane. Fără promisiuni noi și fără ancoră
  proprie. Textul poate conține __floor__ = minimul de comandă calculat.
{%- endcomment -%}
{{ 'kk-landing.css' | asset_url | stylesheet_tag }}
{%- capture kk_floor -%}{%- render 'kk-order-floor' -%}{%- endcapture -%}
{%- assign kk_floor = kk_floor | strip | plus: 0 -%}

<div class="kk-final color-{{ section.settings.color_scheme }} gradient" style="--kk-pt: {{ section.settings.padding_top }}px; --kk-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width kk-final__in">
    {%- if section.settings.heading != blank -%}
      <h2 class="kk-final__title">{{ section.settings.heading | replace: '__floor__', kk_floor | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="kk-final__text">{{ section.settings.text | replace: '__floor__', kk_floor | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
      <div class="kk-final__ctas">
        {%- if section.settings.button_label != blank -%}
          <a class="kk-btn kk-btn--light" href="{{ section.settings.button_link | default: '/collections' }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="kk-btn kk-btn--outline-light" href="{{ section.settings.button2_link | default: '/#start' }}">{{ section.settings.button2_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kosmetikal · Final call",
  "tag": "section",
  "class": "kk-final-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Try it before you brand it."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "__floor__ = the order minimum, computed from the products.",
      "default": "Test the formulas on your own clients, then produce your first batch of __floor__ with your label on it."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Main button",
      "default": "Browse the catalogue"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Main button link",
      "info": "Empty = the collections page."
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Second button",
      "default": "See how to start"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Second button link",
      "info": "Empty = the “How small do you want to start?” section."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [{ "name": "Kosmetikal · Final call" }]
}
{% endschema %}
