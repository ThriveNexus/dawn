{%- comment -%}
  KOSMETIKAL — Panglica de credibilitate (secțiunea 4 din landing V2).
  Un singur rând: etichetă, pastile de text cu certificările (nume + organism
  emitent), link către pagina de certificări. Fără logo-uri sau medalii
  desenate: forma unei mărci de conformitate e a organismului, nu a noastră.
  Fiecare certificare e un bloc, editabil din editorul de temă.
{%- endcomment -%}
{{ 'kk-landing.css' | asset_url | stylesheet_tag }}

<div class="kk-ribbon color-{{ section.settings.color_scheme }} gradient" aria-label="{{ section.settings.label | escape }}">
  <div class="page-width kk-ribbon__in">
    {%- if section.settings.label != blank -%}
      <span class="kk-ribbon__label">{{ section.settings.label | escape }}</span>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.name == blank -%}{%- continue -%}{%- endif -%}
      <span class="kk-lozenge" {{ block.shopify_attributes }}>
        <b>{{ block.settings.name | escape }}</b>
        {%- if block.settings.issuer != blank -%}<span>{{ block.settings.issuer | escape }}</span>{%- endif -%}
      </span>
    {%- endfor -%}
    {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
      <a class="kk-ribbon__more" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kosmetikal · Credentials",
  "tag": "section",
  "class": "kk-ribbon-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Audited and certified"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Certificate numbers and documents"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link",
      "info": "Usually the Compliance & certifications page."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "cert",
      "name": "Certification",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "ISO 9001" },
        { "type": "text", "id": "issuer", "label": "Issued by / scope", "default": "RINA" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Kosmetikal · Credentials",
      "blocks": [
        { "type": "cert", "settings": { "name": "ISO 9001", "issuer": "RINA" } },
        { "type": "cert", "settings": { "name": "ISO 22716 GMP", "issuer": "RINA" } },
        { "type": "cert", "settings": { "name": "ICEA", "issuer": "COSMOS Organic" } },
        { "type": "cert", "settings": { "name": "ICEA", "issuer": "Vegan" } },
        { "type": "cert", "settings": { "name": "AIAB", "issuer": "Bio Eco Cosmesi" } }
      ]
    }
  ]
}
{% endschema %}
