{%- comment -%}
  KOSMETIKAL — „Eticheta ta, pe recipientele noastre” (secțiunea 7 din landing V2).
  Doar descriptivă, fără simulare (decizia lui Claudio): spune că editorul de
  etichete există pe pagina produsului și ce face. Stânga text, dreapta o
  fotografie cu un recipient fără etichetă, cu eticheta punctată „YOUR LABEL”
  așezată pe el (poziția se reglează din editor, în procente).
{%- endcomment -%}
{{ 'kk-landing.css' | asset_url | stylesheet_tag }}

<div id="try" class="kk-labeled color-{{ section.settings.color_scheme }} gradient" style="--kk-pt: {{ section.settings.padding_top }}px; --kk-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width kk-labeled__grid">
    <div class="kk-labeled__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kk-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="kk-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="kk-labeled__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="kk-labeled__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
    <div class="kk-labeled__stage">
      {%- if section.settings.stage_label != blank -%}
        <span class="kk-labeled__watermark">{{ section.settings.stage_label | escape }}</span>
      {%- endif -%}
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        <img src="{{ 'kk-landing-label-tube.jpg' | asset_img_url: '1400x' }}" alt="" loading="lazy" width="1200" height="1599">
      {%- endif -%}
      {%- if section.settings.show_chip and section.settings.chip_text != blank -%}
        <span
          class="kk-labeled__chip"
          style="left: {{ section.settings.chip_x }}%; top: {{ section.settings.chip_y }}%; transform: translate(-50%, -50%) rotate({{ section.settings.chip_rotate }}deg);"
          aria-hidden="true"
        >{{ section.settings.chip_text | escape | newline_to_br }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kosmetikal · Label editor",
  "tag": "section",
  "class": "kk-labeled-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the title",
      "default": "Your label, on our containers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "You design it in the browser, on the real container."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>On every product page there is a label editor loaded with the exact dieline of that product: the printable area, the safe margins, the wrap of the container. You place your artwork on it and you see the finished product before you order.</p><p>The mandatory information a cosmetic label has to carry is already positioned for you, so the part that is easy to get wrong is the part you cannot get wrong.</p>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note",
      "default": "You can also send us your artwork and we place it for you. Either way, nothing goes to print before you have seen it and approved it."
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo (optional)",
      "info": "Empty = the tube photo from the theme."
    },
    {
      "type": "text",
      "id": "stage_label",
      "label": "Corner label",
      "default": "In the editor"
    },
    {
      "type": "checkbox",
      "id": "show_chip",
      "label": "Show the dashed label chip on the photo",
      "default": true
    },
    {
      "type": "text",
      "id": "chip_text",
      "label": "Chip text",
      "default": "YOUR LABEL"
    },
    {
      "type": "range",
      "id": "chip_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Chip position, left to right",
      "default": 34
    },
    {
      "type": "range",
      "id": "chip_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Chip position, top to bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "chip_rotate",
      "min": -45,
      "max": 45,
      "step": 1,
      "unit": "°",
      "label": "Chip rotation",
      "default": -25
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "presets": [{ "name": "Kosmetikal · Label editor" }]
}
{% endschema %}
